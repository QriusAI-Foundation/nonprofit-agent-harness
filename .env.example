# Copy to .env and edit. Never commit the real file.
# Every value here has a working default; nothing below is required to run locally.

# --- Model ---
# echo = offline, deterministic, free, and the default so nothing costs money by accident.
# Others: openai, anthropic, groq, together, openrouter, ollama, local, vllm, google.
# Only google needs an extra install; the rest speak HTTP directly.
HARNESS_PROVIDER=echo
# HARNESS_MODEL=

# Any OpenAI-compatible server. Set OPENAI_BASE_URL to point elsewhere.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Claude.
# ANTHROPIC_API_KEY=

# Gemini. Omit the key to use Vertex AI, which authenticates with the service account
# and so has no long-lived credential to leak.
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Storage ---
# memory = in-process, nothing persisted. gcp = Firestore + Cloud Storage.
HARNESS_STORAGE=memory
# HARNESS_DOCUMENTS_BUCKET=

# --- Budget ceilings, per run ---
# Accepts a number, or none/unlimited/off. 0 means zero, not "unset".
# HARNESS_MAX_COST_USD=1.00
HARNESS_MAX_TOKENS=200000
HARNESS_MAX_CALLS=50

# --- Data handling ---
# Mask emails, phone numbers, and similar identifiers before text reaches a model.
HARNESS_REDACT_INPUTS=false

# --- Claim verification ---
# Checking cited quotes against the source costs nothing, so it is on.
HARNESS_VERIFY_CLAIMS=true
# Cross-checking spends model calls, so it is off until you ask for it. Use an odd
# number of passes, and list as many different models as passes: several passes on
# one model agree with themselves far more readily than independent ones would.
HARNESS_VERIFY_PASSES=0
# HARNESS_VERIFY_MODELS=model-a,model-b,model-c

# --- Auth (off by default: the API is one shared workspace) ---
HARNESS_AUTH_REQUIRED=false
# HARNESS_GOOGLE_CLIENT_ID=
# HARNESS_JWT_SECRET=                 # 32+ bytes
# HARNESS_JWT_TTL_SECONDS=43200
# HARNESS_ADMIN_EMAILS=you@example.org

# --- Sector data sources ---
# IATI Datastore. Free key from https://developer.iatistandard.org
# The no-approval tier allows 5 calls/minute and 100 calls/week, so cache responses.
# IATI_API_KEY=

# --- Agents to register at startup ---
# HARNESS_AGENTS=examples.summarizer:SummarizerAgent

# --- Browser clients ---
# HARNESS_CORS_ORIGINS=http://localhost:3000
